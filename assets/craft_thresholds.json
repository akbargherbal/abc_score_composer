{
  "version": "0.2.3",
  "status": "provisional",
  "why": "The corpus has no lyrics, so it cannot measure text-setting. These four checks are calibrated on one singable score (excellent.txt) and three scores with the reported aimless-scalar defect (07, 11, 16). They are advisory, not corpus percentiles.",
  "calibration": {
    "long_note_share": {
      "excellent": 0.26,
      "07": 0.03,
      "11": 0.07,
      "16": 0.08
    },
    "verse_bars": {
      "excellent": [28, 32],
      "07": [22, 17],
      "11": [26, 21],
      "16": [22, 17]
    }
  },
  "thresholds": {
    "long_note_beats": 1.0,
    "long_note_share_min": 0.17,
    "verse_bars_mod": 4,
    "line_bars_allowed": [2, 4],
    "bayt_bars": 8,
    "breath_rest_min": 0.5,
    "phrase_break_beats": 1.5,
    "min_phrase_notes": 2,
    "verse_register_range_min": 12,
    "rhythm_variety_min": 0.20,
    "contour_overlap_max": 0.80
  },
  "variety": {
    "provisional": true,
    "calibration": "uncalibrated"
  }
}
